<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>Disabled</key>
        <false/>
        <key>Label</key>
        <string>org.stunnel</string>
        <key>ProgramArguments</key>
        <array>
                <string>/usr/local/bin/stunnel</string>
                <string>/usr/local/etc/stunnel/stunnel.conf</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>WorkingDirectory</key>
        <string>/usr/local/etc/stunnel</string>
        <key>KeepAlive</key>
        <true/>
        <key>UserName</key>
        <string>root</string>
</dict>
</plist>
