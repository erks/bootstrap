[alias]
    svnup = "!git svn fetch --all; git svn rebase"
    svnsw = "!f() { git co $1; git svnup; }; f"
    co = checkout
    ci = commit
    st = status --short --branch
    br = branch --verbose --verbose
    l = log --decorate --name-status
    ll = log --decorate --name-status --all
    f = fetch --all --prune --tags
    m = merge
    p = pull --all --prune
    pu = pull upstream --all --prune
    sub = submodule
    subup = submodule update --recursive --init
[user]
	name = Touch Ungboriboonpisal
	useconfigonly = true
[push]
	default = tracking
[credential]
	helper = osxkeychain
[http]
	sslVerify = false
[color]
    ui = auto
[core]
	autocrlf = input
[diff]
    algorithm = patience
